# Copia este archivo como .env y ajusta los valores.
# docker compose lo lee automáticamente; para la app, exporta estas variables
# o usa el perfil "dev" (valores por defecto en application-dev.yml).

DB_HOST=localhost
DB_PORT=5433
DB_NAME=planificacion
DB_USER=planificacion
DB_PASSWORD=planificacion

# Clave HMAC para firmar los JWT: mínimo 32 bytes, en Base64.
# Genera una con:  openssl rand -base64 48
JWT_SECRET=
