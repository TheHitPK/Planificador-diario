# Copia este archivo como .env y ajusta los valores.
# docker compose lo lee automáticamente; para la app, exporta estas variables
# o usa el perfil "dev" (valores por defecto en application-dev.yml).

DB_HOST=localhost
DB_PORT=5433
DB_NAME=planificacion
DB_USER=planificacion
DB_PASSWORD=planificacion

# Clave HMAC para firmar los JWT: mínimo 32 bytes, en Base64.
# Genera una con:  openssl rand -base64 48
JWT_SECRET=

# --- Producción (perfil prod: SPRING_PROFILES_ACTIVE=prod) ---
# URL JDBC completa. Ojo: JDBC NO acepta usuario:password dentro de la URL;
# van aparte en DB_USER / DB_PASSWORD.
#   Neon:     jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase: jdbc:postgresql://aws-0-xx.pooler.supabase.com:5432/postgres?sslmode=require
#             (usuario del pooler: postgres.<project-ref>)
# DB_URL=
# Dominio(s) del frontend, separados por comas.
# CORS_ALLOWED_ORIGINS=https://mi-app.vercel.app

# --- Correo (Brevo) ---
# Sin BREVO_API_KEY (desarrollo) los correos se escriben en el log del backend.
# BREVO_API_KEY=xkeysib-...
# Remitente verificado en Brevo (Senders & IP > Senders).
# MAIL_FROM=tu-correo@gmail.com
# MAIL_FROM_NAME=Planificación diaria
# Base de los enlaces de los correos (la URL del frontend).
# FRONTEND_URL=https://mi-app.vercel.app
